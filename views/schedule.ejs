<!DOCTYPE html>
<html lang="ko">
<head> 
    <meta charset="UTF-8">
    <title> 박현빈 스케줄 </title>

    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="schedule-body">
    
    <h1> 강의시간표 및 주계획 </h1>

    <table>
        <tr>
            <th>요일</th>
            <th>1교시 (9:00 ~ 9:50) </th>
            <th>2교시 (9:55 ~ 10:45) </th>
            <th>3교시 (10:50 ~ 11:40) </th>
            <th>4교시 (11:45 ~ 12:35) </th>
            <th>5교시 (12:40 ~ 13:30) </th>
            <th>6교시 (13:35 ~ 14:25) </th>
            <th>7교시 (14:30 ~ 15:20) </th>
            <th>8교시 (15:25 ~ 16:15) </th>
            <th>9교시 (16:20 ~ 17:10) </th>
            <th>10교시 (17:15 ~ 18:05) </th>
        </tr>

        <tr class="mon">
            <td>월요일</td>
            <td colspan="5">공강 </td>
            <td colspan="2">ADsP 자격증 공부</td>
            <td colspan="2">Opic test 공부</td>
            <td>공강</td>
        </tr>

        <tr class="tue">
            <td>화요일</td>
            <td>공강 </td>
            <td colspan="3">웹 개발 실습 </td>
            <td colspan="3">ADsP 자격증 공부</td>
            <td colspan="3">Opic test 공부</td>
        </tr>

        <tr class="wed">
            <td>수요일</td>
            <td colspan="3">사물 인터넷 실습 </td>
            <td>공강</td>
            <td colspan="2">클라우드 컴퓨팅 실습</td>
            <td colspan="4">ADsP 자격증 or Opic test 공부</td>
        </tr>

        <tr class="thu">
            <td>목요일</td>
            <td colspan="4">공강 </td>
            <td>공강</td>
            <td colspan="2">ADsP 자격증 공부</td>
            <td colspan="2">Opic test 공부</td>
            <td>공강</td>
        </tr>

        <tr class="fri">
            <td>금요일</td>
            <td colspan="2">네트워크 보안</td>
            <td>공강</td>
            <td colspan="3">PCB설계 실습</td>
            <td>공강</td>
            <td colspan="3">RF공학 실습</td>
        </tr>
    </table>

    <div class="schedule-events">
    <h2>주요 일정</h2>
    <!-- 리스트화 -->
    <ul>
        <li>10월 19일 ~ 23일 : 중간고사</li>
        <li>10월 27일 예비군</li>
        <li>10월 31일 ADsP 시험</li>
        <li>12월 7일 ~ 11일 기말고사</li>
        <li>12월 말 Opic test 시험 예정</li>
    </ul>
    </div>
    </div>

<script> /*자바스크립트*/
    const today = new Date().getDay(); /*요일을 받아서 숫자로 변환*/

    const days = [ /*배열*/
        "",
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        ""
    ];

    const todayRow = document.querySelector("." + days[today])

    if (todayRow) {
        todayRow.classList.add("today");
    }
</script>
</body>
</html>